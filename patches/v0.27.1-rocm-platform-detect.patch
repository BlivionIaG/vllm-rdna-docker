diff --git a/vllm/platforms/__init__.py b/vllm/platforms/__init__.py
index ac536af..f6aae32 100644
--- a/vllm/platforms/__init__.py
+++ b/vllm/platforms/__init__.py
@@ -125,6 +125,25 @@ def rocm_platform_plugin() -> str | None:
     except Exception as e:
         logger.debug("ROCm platform is not available because: %s", str(e))
 
+    # Fallback: amdsmi cannot enumerate devices once torch has taken the HIP
+    # context (amdsmi_get_processor_handles() returns 0 after torch.cuda
+    # initializes, on both bare metal and in containers). torch.version.hip is
+    # authoritative for a ROCm torch build. NOTE: do NOT also require
+    # torch.cuda.is_available() here — vLLM sets PYTORCH_NVML_BASED_CUDA_CHECK=1
+    # at import, which spawned workers inherit; is_available() then takes the
+    # NVML path, returns False on ROCm (no NVIDIA NVML), and platform
+    # detection would fall through to UnspecifiedPlatform. torch.version.hip
+    # alone distinguishes a ROCm wheel; CUDA boxes are still caught by the
+    # cuda_platform_plugin evaluated first.
+    if not is_rocm:
+        try:
+            import torch
+            if torch.version.hip is not None:
+                is_rocm = True
+                logger.debug("Confirmed ROCm platform via torch.version.hip fallback.")
+        except Exception as e:
+            logger.debug("ROCm platform torch fallback failed: %s", str(e))
+
     return "vllm.platforms.rocm.RocmPlatform" if is_rocm else None
 
 
